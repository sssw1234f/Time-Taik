# Gemini API 키 이중화(Failover) 환경변수 설정 예시
# 1차 키(기본)와 2차 키(보조)를 등록하면 첫 번째 키의 할당량 소진 시 자동으로 두 번째 키로 전환됩니다.

# 백엔드/일반 환경변수
GEMINI_API_KEY_1=AIzaSyYourFirstApiKeyHere
GEMINI_API_KEY_2=AIzaSyYourSecondApiKeyHere

# VITE_ 접두사 형식 지원
VITE_GEMINI_API_KEY_1=AIzaSyYourFirstApiKeyHere
VITE_GEMINI_API_KEY_2=AIzaSyYourSecondApiKeyHere

# 기존 단일 키 호환
GEMINI_API_KEY=AIzaSyYourFirstApiKeyHere
